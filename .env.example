# Local development
NODE_ENV=development

# Owner connection - migrations only
DATABASE_URL=postgres://jfs:jfs_local_dev@localhost:5433/jatelo_fleet
# API connection - Row-Level Security enforced (one tenant at a time)
APP_DATABASE_URL=postgres://jfs_api:jfs_api_local_dev@localhost:5433/jatelo_fleet
# Worker / ingest / super-admin connection - bypasses RLS
SYSTEM_DATABASE_URL=postgres://jfs_worker:jfs_worker_local_dev@localhost:5433/jatelo_fleet

REDIS_URL=redis://localhost:6379
# Seed (optional locally; SEED_SUPERADMIN_PASSWORD required in production)
# SEED_SUPERADMIN_EMAIL=evans.onyango@jatelo-techs.com
# SEED_SUPERADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=

# API
PORT=4000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=1
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=300

# Auth - generate real values: 48 random bytes (JWT) and 32 random bytes (MFA), base64
JWT_ACCESS_SECRET=replace-with-48-random-bytes-base64-encoded-value
MFA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
WEB_APP_URL=http://localhost:5173
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=Jatelo Fleet Solutions <no-reply@jatelo-techs.com>

# Object storage (S3-compatible: RustFS locally, Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jfs-files
S3_ACCESS_KEY_ID=jfs_storage
S3_SECRET_ACCESS_KEY=jfs_storage_local_dev
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# Ingestion gateway
INGEST_HTTP_PORT=5080
TELTONIKA_PORT=5027
GT06_PORT=5023
QUECLINK_PORT=5004
INGEST_IDLE_TIMEOUT_S=900
# Public URL phones upload GPS to (driver app "phone as tracker")
INGEST_PUBLIC_URL=http://localhost:5080
# Set a listener port to 0 to disable it (e.g. one Railway service per protocol)

# Worker
WORKER_BATCH_SIZE=500
# INSTANCE_ID=worker-1

# Notifications (all optional - without them SMS/email/push are logged instead of sent)
# Africa's Talking SMS (KE/TZ/UG/RW): username, API key, optional alphanumeric sender id
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=JATELO
# Firebase Cloud Messaging HTTP v1 for the driver app: the whole service-account JSON on one line
# FCM_SERVICE_ACCOUNT_JSON=

# Routing (optional): OSRM for road distances/ETAs, VROOM for multi-stop optimisation.
# Without them the built-in optimiser and straight-line estimates are used.
# OSRM_URL=http://localhost:5000
# VROOM_URL=http://localhost:3000

# M-Pesa Daraja (Kenya). Without credentials, payments are simulated outside production.
MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# A long random string; callbacks arrive at {PUBLIC_API_URL}/api/v1/public/mpesa/callback/{MPESA_CALLBACK_SECRET}
# MPESA_CALLBACK_SECRET=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
