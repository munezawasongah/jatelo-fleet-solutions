{
  "name": "jatelo-fleet-solutions",
  "private": true,
  "description": "Jatelo Fleet Solutions - multi-tenant fleet management SaaS for East Africa",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "\u003e=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:new": "pnpm --filter @jfs/db migrate:new",
    "db:migrate": "pnpm --filter @jfs/db migrate",
    "db:status": "pnpm --filter @jfs/db migrate:status",
    "db:seed": "pnpm --filter @jfs/db seed",
    "db:seed:base": "pnpm --filter @jfs/db seed:base"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
